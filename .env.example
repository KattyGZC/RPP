# ======================================================
# READ PRAXIS PROJECT - Environment Configuration
# ======================================================
# Copy this file to .env and fill in your values
# Never commit the .env file to version control

# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-very-long-and-secure-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL)
POSTGRES_DB=rpp_db
POSTGRES_USER=rpp_user
POSTGRES_PASSWORD=your-secure-db-password
DATABASE_URL=postgres://rpp_user:your-secure-db-password@postgres:5432/rpp_db

# Redis
REDIS_URL=redis://redis:6379/0

# Media files
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:80

# ======================================================
# AI Provider Configuration (Strategy Pattern)
# ======================================================
# Primary transcription provider: "whisper_local" | "openai" | "azure"
AI_TRANSCRIPTION_PROVIDER=whisper_local

# Primary feedback provider: "nlp_local" | "claude" | "openai"
AI_FEEDBACK_PROVIDER=nlp_local

# Whisper local model size: "tiny" | "base" | "small" | "medium" | "large"
# tiny=fastest/least accurate, large=slowest/most accurate
# For Spanish reading: "small" offers best speed/accuracy tradeoff
WHISPER_MODEL_SIZE=small

# OpenAI (optional - only needed if AI_TRANSCRIPTION_PROVIDER=openai)
# OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic Claude (optional - only needed if AI_FEEDBACK_PROVIDER=claude)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# ======================================================
# JWT Configuration
# ======================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
